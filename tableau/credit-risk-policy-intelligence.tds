<?xml version='1.0' encoding='utf-8'?>
<datasource inline="false" name="analytics" caption="Credit Risk &amp; Policy Intelligence (synthetic)" version="9.3">
      <connection class="textscan" directory="Data" filename="monthly.csv" server="" password="" locale="en_US">
        <relation name="monthly.csv" table="[monthly.csv]" type="table">
          <columns header="yes" separator="," character-set="UTF-8">
            <column datatype="string" name="month" ordinal="0" />
            <column datatype="string" name="segment" ordinal="1" />
            <column datatype="integer" name="applications" ordinal="2" />
            <column datatype="integer" name="defaults" ordinal="3" />
            <column datatype="integer" name="approved" ordinal="4" />
            <column datatype="integer" name="approved_defaults" ordinal="5" />
            <column datatype="real" name="funded_amount" ordinal="6" />
            <column datatype="real" name="contribution" ordinal="7" />
            <column datatype="date" name="month_date" ordinal="8" />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class="column">
            <remote-name>month</remote-name>
            <remote-type>130</remote-type>
            <local-name>[month]</local-name>
            <parent-name>[monthly.csv]</parent-name>
            <remote-alias>month</remote-alias>
            <ordinal>0</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>false</contains-null>
          </metadata-record>
