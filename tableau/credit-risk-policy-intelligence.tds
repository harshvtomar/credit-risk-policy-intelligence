      <column name="[month]" caption="Month" datatype="string" role="dimension" type="nominal" />
      <column name="[segment]" caption="Segment" datatype="string" role="dimension" type="nominal" />
      <column name="[applications]" caption="Applications" datatype="integer" role="measure" type="quantitative" />
      <column name="[defaults]" caption="Defaults" datatype="integer" role="measure" type="quantitative" />
      <column name="[approved]" caption="Approved" datatype="integer" role="measure" type="quantitative" />
      <column name="[approved_defaults]" caption="Approved Defaults" datatype="integer" role="measure" type="quantitative" />
      <column name="[funded_amount]" caption="Funded Amount" datatype="real" role="measure" type="quantitative" />
      <column name="[contribution]" caption="Contribution" datatype="real" role="measure" type="quantitative" />
      <column name="[month_date]" caption="Month Date" datatype="date" role="dimension" type="nominal" />
      <column name="[Calculation_KPI_0]" caption="Applications" datatype="real" role="measure" type="quantitative" default-format="#,##0">
        <calculation class="tableau" formula="SUM([applications])" />
      </column>
      <column name="[Calculation_KPI_1]" caption="Default rate" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="IF SUM([applications]) = 0 THEN NULL ELSE SUM([defaults]) / SUM([applications]) END" />
      </column>
      <column name="[Calculation_KPI_2]" caption="Approval rate" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="IF SUM([applications]) = 0 THEN NULL ELSE SUM([approved]) / SUM([applications]) END" />
      </column>
      <column name="[Calculation_KPI_3]" caption="Policy contribution" datatype="real" role="measure" type="quantitative" default-format="$#,##0">
        <calculation class="tableau" formula="SUM([contribution])" />
      </column>
    </datasource>
  